# Optional LLM API Configuration (SyllabAI runs 100% locally without any API keys!)
# Set any of these to enable Hybrid LLM Agent orchestration alongside local PyTorch/MILP models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Persistence
DATABASE_URL=sqlite:///./syllabai.db
API_HOST=0.0.0.0
API_PORT=8000
